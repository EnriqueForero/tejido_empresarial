# ─────────────────────────────────────────────────────────────────────────────
# Tejido Empresarial · ProColombia — variables de entorno
# Copie este archivo a `.env` sólo para desarrollo local. En Railway configure
# las variables desde el panel del servicio; nunca suba llaves al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# --- Snowflake (obligatorias en producción) ---------------------------------
SF_ACCOUNT=
SF_USER=
SF_DATABASE=APP_SEGMENTACION_EXPORTACIONES
SF_SCHEMA=SEGMENTACION
SF_WAREHOUSE=APPS_WH
SF_ROLE=APP_SEGMENTACION_EXPORTACIONES

# Llave privada RSA (DER) del usuario de servicio. En Railway use la versión Base64.
# Convertir: PowerShell  [Convert]::ToBase64String([IO.File]::ReadAllBytes("rsa_key_1.der"))
#            macOS/Linux base64 -w 0 rsa_key_1.der
SF_PRIVATE_KEY_B64_1=
SF_PRIVATE_KEY_PASSPHRASE_1=
# Segunda llave (rotación / respaldo). Opcional.
SF_PRIVATE_KEY_B64_2=
SF_PRIVATE_KEY_PASSPHRASE_2=
# Alternativa local a Base64: ruta en disco al archivo .der
SF_PRIVATE_KEY_PATH_1=
SF_PRIVATE_KEY_PATH_2=

# --- Aplicativo --------------------------------------------------------------
# production | development (development habilita /api/docs)
APP_ENV=development
# true = datos sintéticos, sin Snowflake. Útil para probar la interfaz.
APP_DEMO_MODE=false
# URL pública HTTPS del servicio (para metadatos sociales). Ej.: https://tejido.up.railway.app
PUBLIC_ORIGIN=
# Máximo de empresas por archivo Excel (1 a 20000).
EXPORT_MAX_ROWS=5000
# Incluir dirección, teléfono, correo y representante legal en la descarga (como en Streamlit).
EXPORT_INCLUDE_CONTACT_FIELDS=true
# Tamaño máximo del cuerpo HTTP en bytes.
MAX_REQUEST_BYTES=2000000

# --- Acceso (opcional) --------------------------------------------------------
# Si se configuran AMBAS, todo el aplicativo pide usuario y contraseña (HTTP Basic).
# Si se dejan vacías, el acceso es abierto, igual que la versión Streamlit.
APP_BASIC_USER=
APP_BASIC_PASSWORD=
